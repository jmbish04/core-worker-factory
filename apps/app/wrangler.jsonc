{
  // [METADATA]
  // Application identity and Cloudflare runtime compatibility settings.
  "name": "core-worker-factory",
  "compatibility_date": "2025-12-15",
  "compatibility_flags": ["nodejs_compat"],

  // [OBSERVABILITY]
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // [BUILD]
  "upload_source_maps": true,
  
  // Enables deployment to a *.workers.dev subdomain
  "workers_dev": true,

  // [ASSETS]
  // Serves bundled JavaScript, CSS, images, and other static assets.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  // [VARS]
  // Environment variables available to the Worker (if a script is added) 
  // or used for system configuration.
  "vars": {
    "API_URL": "https://core-worker-factory-api.hacolby.workers.dev"
  }
}
